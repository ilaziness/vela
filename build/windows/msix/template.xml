<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Vela.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Vela Team\Vela">
    </Installer>
    <PackageInformation
        PackageName="Vela"
        PackageDisplayName="Vela"
        PublisherName="CN=Vela Team"
        PublisherDisplayName="Vela Team"
        Version="0.1.0.0"
        PackageDescription="Vela is an SSH desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.ilaziness.vela"
                Description="Vela is an SSH desktop client"
                DisplayName="Vela"
                ExecutableName="Vela.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Vela</DisplayName>
            <PublisherDisplayName>Vela Team</PublisherDisplayName>
            <Description>Vela is an SSH desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Vela.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
